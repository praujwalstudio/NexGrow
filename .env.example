# NexGrow environment configuration
# Copy to .env and fill in values. Never commit .env.

# OpenWeatherMap API key for weather-aware treatment advice
OPENWEATHER_API_KEY=

# Path to the trained NexGrow checkpoint
# (default: models/student_model/student.pth)
NEXGROW_MODEL=models/student_model/student.pth

# Optional YOLO11 leaf detector weights (leave empty to disable detection)
NEXGROW_DETECTOR=
