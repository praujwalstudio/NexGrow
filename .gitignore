!data/augmented/.gitkeep

# Model weights
models/detection/*.pt
models/teacher_ensemble/*.pt
models/student_model/*.pt
models/quantized/*.onnx
models/quantized/*.tflite
models/**/*.pth
models/**/*.ckpt
!models/**/.gitkeep

